<div id="hud"><div id="flash"></div><div id="cross"></div><div id="msg"></div><div id="info"></div><div id="tip"></div><div id="hpb"><div id="hp"></div></div><canvas id="mm" width="140" height="140"></canvas></div>

<div id="menu" class="ov on"><div class="card"><h1>Arène Zénith</h1>
<p>Shooter 3D de bataille · <b id="coins"></b> pièces</p>
<p>Map : <select id="map"></select></p>
