.it{display:flex;align-items:center;gap:10px;margin:8px 0}.it span{flex:1}.sw{width:28px;height:28px;border-radius:50%}
#hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:2}
#cross{position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px;border:2px solid #fff;border-radius:50%;opacity:.8}
#hpb{position:absolute;left:16px;bottom:16px;width:240px;height:18px;background:#0008;border-radius:9px;overflow:hidden}#hp{height:100%;width:100%;background:var(--cy)}
#info{position:absolute;right:16px;top:12px;text-align:right;font-weight:700;text-shadow:0 1px 3px #000}
#msg{position:absolute;left:16px;top:12px;font-size:14px;text-shadow:0 1px 3px #000}
#tip{position:absolute;bottom:44px;left:16px;font-size:13px;color:#fff;text-shadow:0 1px 3px #000}
