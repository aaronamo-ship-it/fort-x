function mini(){const s=140/(size*2);mm.clearRect(0,0,140,140);mm.fillStyle='rgba(18,10,36,.7)';mm.fillRect(0,0,140,140);if(mode==='br'){mm.strokeStyle='#d946ef';mm.lineWidth=2;mm.beginPath();mm.arc(70,70,sR*s,0,7);mm.stroke()}for(const e of E)if(e.alive){mm.fillStyle=e===P?'#fff':e.team===0?'#4aa3ff':'#ff4a4a';const z=e===P?5:4;mm.fillRect(70+e.x*s-z/2,70+e.z*s-z/2,z,z)}}
function showcase(){size=60;mode='';gen(Math.min(+$('map').value||0,2),0,0);while(EG.children.length)EG.remove(EG.children[0]);E=[];ring.visible=false;const k=SK[S.skin];hero=ent(0,k[1],k[2],1)}
function dirv(){return new T.Vector3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch))}
function update(dt){
 tm+=dt;bcd-=dt;P.cd-=dt;
 const ix=(K.KeyD?1:0)-(K.KeyA?1:0),iz=(K.KeyW?1:0)-(K.KeyS?1:0),f=[-Math.sin(yaw),-Math.cos(yaw)],r=[Math.cos(yaw),-Math.sin(yaw)];
 const l=Math.hypot(ix,iz)||1,sp=(mode==='cr'?14:7)*A.spd*dt;
 if(P.alive){
  if(mode==='cr'){P.x+=((f[0]*iz+r[0]*ix)/l)*sp;P.z+=((f[1]*iz+r[1]*ix)/l)*sp;P.y+=((K.Space?1:0)-(K.ShiftLeft?1:0))*sp;P.y=Math.max(0,P.y)}
  else{mv(P,((f[0]*iz+r[0]*ix)/l)*sp,((f[1]*iz+r[1]*ix)/l)*sp);if(K.Space&&P.onG)P.vy=10*A.jump;phys(P,dt)}
  P.yaw=yaw;
  if(fire&&mode!=='cr'&&P.cd<=0){P.cd=A.rapid?.07:.22;cam.updateMatrixWorld();const d=new T.Vector3();cam.getWorldDirection(d);shoot(P,cam.position.clone(),d,20)}
  if(K.KeyF)build('w');if(K.KeyG)build('s');
 }
 for(const b of E)if(b.bot&&b.alive)ai(b,dt);
 if(mode==='br'){sR=Math.max(8,size-tm*(size-8)/200);ring.scale.set(sR,1,sR);
  for(const e of E)if(e.alive&&Math.hypot(e.x,e.z)>sR)hit(e,5*dt,null)}
 for(const e of E){e.g.position.set(e.x,e.y+(e.onG?Math.abs(Math.sin(tm*9+e.t))*.06:0),e.z);e.g.rotation.y=e.yaw+Math.PI}
 for(let i=TR.length-1;i>=0;i--){TR[i][1]-=dt;if(TR[i][1]<=0){sc.remove(TR[i][0]);TR.splice(i,1)}}
 const d=dirv(),head=new T.Vector3(P.x,P.y+1.7,P.z);
 if(mode==='cr'){cam.position.copy(head);cam.lookAt(head.clone().add(d))}
 else{const bk=d.clone().negate().normalize();RC.set(head,bk);RC.far=5;const h=RC.intersectObjects(W.children,true),dd=h.length?Math.max(.4,h[0].distance-.3):5;
  cam.position.copy(head).addScaledVector(bk,dd).add(new T.Vector3(r[0],0,r[1]).multiplyScalar(.9*dd/5));cam.position.y=Math.max(.3,cam.position.y);cam.lookAt(head.clone().addScaledVector(d,30))}
 $('hp').style.width=Math.max(0,P.hp)+'%';mini();ring.material.opacity=.2+.08*Math.sin(tm*3);
 for(let i=PT.length-1;i>=0;i--){const q=PT[i];q.l-=dt;q.v.y-=15*dt;q.m.position.addScaledVector(q.v,dt);q.m.scale.setScalar(Math.max(.01,q.l*2));if(q.l<=0){sc.remove(q.m);PT.splice(i,1)}}
 $('info').innerHTML=mode==='cr'?'Créatif · bloc '+(bsel+1)+' · '+S.cmap.length+' blocs':(mode.toUpperCase())+' · en vie '+E.filter(e=>e.alive).length+' · éliminations '+P.k+(mode==='br'?'<br>Tempête : '+Math.round(sR)+' m':'');
}
function cell(rm){RC.setFromCamera({x:0,y:0},cam);RC.far=60;const h=RC.intersectObjects([GR,...W.children],false);if(!h.length)return;
 const x=h[0];if(rm){if(x.object.userData.k){const k=x.object.userData.k;W.remove(x.object);S.cmap=S.cmap.filter(b=>b!==k)}return}
 const q=x.point.clone().addScaledVector(x.face.normal,2),c=[Math.floor(q.x/4),Math.floor(q.y/4),Math.floor(q.z/4)];
 if(c[1]<0||S.cmap.some(b=>b[0]===c[0]&&b[1]===c[1]&&b[2]===c[2]))return;const b=[...c,bsel];S.cmap.push(b);blk(b)}
addEventListener('mousemove',e=>{if(run&&(document.pointerLockElement||fb)){yaw-=e.movementX*.0025;pitch=Math.max(-1.4,Math.min(1.4,pitch-e.movementY*.0025))}});
addEventListener('mousedown',e=>{if(!run||paused)return;if(e.button===0){fire=1;if(mode==='cr')cell(0)}else if(e.button===2&&mode==='cr')cell(1)});
addEventListener('mouseup',()=>fire=0);addEventListener('contextmenu',e=>e.preventDefault());
addEventListener('wheel',e=>{if(mode==='cr')bsel=(bsel+(e.deltaY>0?1:4))%5});
addEventListener('keydown',e=>{K[e.code]=1;if(e.code==='Space')e.preventDefault();if(mode==='cr'&&/^Digit[1-5]$/.test(e.code))bsel=+e.code[5]-1;if(mode==='cr'&&e.code==='KeyP'){sv();say('Map sauvegardée')}});
addEventListener('keyup',e=>K[e.code]=0);
document.addEventListener('pointerlockchange',()=>{if(run&&!document.pointerLockElement&&!fb){paused=1;$('pause').classList.add('on')}});
document.addEventListener('pointerlockerror',()=>{fb=1;paused=0});
$('bres').onclick=()=>{$('pause').classList.remove('on');paused=0;R.domElement.requestPointerLock&&R.domElement.requestPointerLock()};
$('bquit').onclick=()=>{if(mode==='cr')sv();run=0;$('pause').classList.remove('on');$('hud').style.display='none';menu()};
$('bmenu').onclick=()=>{$('end').classList.remove('on');menu()};
$('badm').onclick=$('badm2').onclick=()=>$('adm').classList.add('on');
$('bshop').onclick=()=>{drawShop();$('shop').classList.add('on')};
$('a_coins').onclick=()=>{S.coins+=1000;sv();menu(1)};$('a_unl').onclick=()=>{S.own=SK.map((_,i)=>i);sv()};
$('a_kill').onclick=()=>{E.filter(e=>e.bot&&e.alive).forEach(e=>kill(e,P))};
$('a_rst').onclick=()=>{S={coins:200,own:[0],skin:0,cmap:[]};sv();menu(1)};
function drawShop(){$('sl').innerHTML='';SK.forEach((s,i)=>{const d=document.createElement('div');d.className='it';
 d.innerHTML='<div class="sw" style="background:#'+s[1].toString(16).padStart(6,'0')+'"></div><span>'+s[0]+'</span>';const b=document.createElement('button');
 const own=S.own.includes(i);b.textContent=S.skin===i?'Équipé':own?'Équiper':s[3]+' pièces';b.className=own?'alt':'';
 b.onclick=()=>{if(own)S.skin=i;else if(S.coins>=s[3]){S.coins-=s[3];S.own.push(i);S.skin=i}sv();menu(1);drawShop()};d.appendChild(b);$('sl').appendChild(d)})}
function menu(keep){$('coins').textContent=S.coins;if(!keep)$('menu').classList.add('on');
 const sel=$('map'),v=sel.value;sel.innerHTML=MAPS.map((m,i)=>'<option value='+i+'>'+m.n+'</option>').join('')+(S.cmap.length?'<option value=3>Ma map ('+S.cmap.length+' blocs)</option>':'');sel.value=v||0;if(!run)showcase()}
document.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>{const mi=+$('map').value;play(b.dataset.m,b.dataset.m==='br'&&mi===3?0:mi)});
$('map').onchange=()=>showcase();menu(1);let last=0;
(function loop(t){requestAnimationFrame(loop);const dt=Math.min(.05,(t-last)/1000);last=t;if(run&&!paused)update(dt);
 if(!run&&hero){const a=t/5000,x=Math.cos(a)*7,z=Math.sin(a)*7;hero.g.rotation.y=t/1500;cam.position.set(x,2.4,z);cam.lookAt(-z/7*2.2*-1,1.2,x/7*2.2*-1)}
 const c=run&&P?P:{x:0,y:0,z:0};sun.position.set(c.x+30,c.y+60,c.z+20);sun.target.position.set(c.x,c.y,c.z);sun.target.updateMatrixWorld();R.render(sc,cam)})(0);
</script></body></html>
