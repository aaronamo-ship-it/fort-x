body{font-family:Rajdhani,"Trebuchet MS",sans-serif;font-size:17px}
.ov{background:radial-gradient(ellipse at 20% 50%,rgba(18,10,36,.82),rgba(18,10,36,.2));backdrop-filter:blur(2px)}
#menu{justify-content:flex-start;padding-left:6vw}
.card{background:rgba(29,18,56,.72);backdrop-filter:blur(14px);border:1px solid rgba(46,230,214,.35);box-shadow:0 0 40px rgba(217,70,239,.25),inset 0 0 30px rgba(46,230,214,.06);border-radius:20px}
