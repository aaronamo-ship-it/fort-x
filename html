<div id="pause" class="ov"><div class="card"><h2>Pause</h2><div class="row"><button id="bres">Reprendre</button><button class="alt" id="badm2">Admin</button><button class="alt" id="bquit">Quitter</button></div></div></div>
<div id="end" class="ov"><div class="card"><h2 id="et"></h2><p id="ed"></p><button id="bmenu">Retour au menu</button></div></div>

<div id="shop" class="ov"><div class="card"><h2>Boutique de skins</h2><div id="sl"></div><button class="alt" onclick="shop.classList.remove('on')">Fermer</button></div></div>
<div id="adm" class="ov"><div class="card"><h2>Panneau admin</h2>
<div class="it"><span>Invincible</span><input type="checkbox" id="a_god"></div>
<div class="it"><span>Tir rapide</span><input type="checkbox" id="a_rapid"></div>
